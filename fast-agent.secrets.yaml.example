# Copy to `fast-agent.secrets.yaml` (gitignored) if you prefer keeping provider
# keys here instead of in environment variables. Either source works; env vars
# from `.env` take precedence for the keys fast-body reads directly.
anthropic:
  api_key: <your-anthropic-key>
openai:
  api_key: <your-openai-key>
google:
  api_key: <your-google-key>
