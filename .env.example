# ── fast-body environment ──────────────────────────────────────────────
# Copy to `.env` and fill in. Values here are loaded at startup (python-dotenv)
# and also picked up by the fast-agent brain for provider API keys.

# Voice (OpenAI STT + TTS). Required.
OPENAI_API_KEY=sk-...

# Voice tuning (optional)
VOICE_BACKEND=openai          # openai | realtime | text (stdin) | none (browser page only)
OPENAI_STT_MODEL=gpt-transcribe          # gpt-4o-transcribe shuts down 2027-02-26
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Blank or "auto" = the personality card's voice (falling back to cedar).
# Set a voice name (alloy | ash | ballad | cedar | coral | echo | fable |
# marin | nova | onyx | sage | shimmer | verse) to pin it regardless of card.
OPENAI_TTS_VOICE=auto
# How to speak, as opposed to which voice — tone, pace, emotion. Blank follows the
# personality card's `delivery`. Only the gpt-4o-mini-tts family accepts this.
TTS_DELIVERY=
# Speak through an OpenAI-compatible server instead of OpenAI (a Qwen3-TTS server
# exposes /v1/audio/speech). Blank = OpenAI. TTS_API_KEY defaults to OPENAI_API_KEY,
# which the speech-to-text half still needs either way.
TTS_BASE_URL=
TTS_API_KEY=

# Brain provider keys — set whichever matches `default_model` in fast-agent.config.yaml.
# fast-agent reads these directly from the environment.
# Not needed for an hf. model: fast-agent uses the token from `hf auth login`.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# MCP servers from fast-agent.config.yaml that the body should attach to,
# comma-separated (e.g. "fetch,memory"). Empty = none. Servers added from the
# settings page (Home Assistant among them) are not listed here.
FAST_BODY_SERVERS=

# Extra skill directories, separated by the platform's path separator. Skills
# served by attached MCP servers are installed under ~/.fast-body/skills/.
FAST_BODY_SKILLS=

# Personality — which card in src/fast_body/personalities/ the robot plays
# (default | marvin | tavern | your own). Also settable from the settings page.
FAST_BODY_PERSONALITY=default
# Extra directory of your own personality cards (fast-agent AgentCard .md files).
# A card here with the same name as a built-in overrides it. Cards in
# ~/.fast-body/personalities/ are found without this being set.
FAST_BODY_PERSONALITIES_DIR=

# Robot
ROBOT_NAME=                   # blank = auto-discover

# Feature flags
ENABLE_CAMERA=true            # camera tool + face tracking (look_at_me)
FAST_BODY_VISION_MODEL=gpt-5-mini  # the OpenAI model behind examine(question)
# Companion browser page — a live transcript you can also type into. This is the
# only way to talk to the robot while the daemon runs it headless.
ENABLE_WEB_CHAT=true          # keep on for a daemon-installed app: the dashboard stops an app whose page never answers
WEB_CHAT_PORT=8080
WEB_CHAT_HOST=0.0.0.0         # 127.0.0.1 keeps it on the robot itself
WEB_CHAT_TOKEN=               # blank = open to your network; set one (8+ chars) and the page asks for it once per browser
HEAD_TRACKING_WEIGHT=1.0      # how strongly tracking owns the head: 1 = full eye contact,
                              # lower lets the active emotion/dance show through
HEAD_TRACKING_SPEAKING_WEIGHT=0.3  # …and while the robot is speaking
ENABLE_WOBBLE=true            # audio-reactive head sway while speaking (on-robot LOCAL audio only)
FACE_TRACKING=false           # follow the person's face from startup. Off by default: it shares
                              # the camera with camera() and moves the head while a still is taken.
                              # The brain can still turn it on with look_at_me. Also in the UI.
ENABLE_BARGE_IN=true          # talk over the robot to interrupt it, and keep the mic live while
                              # it speaks. The robot's own audio path cancels echo; set false for
                              # external/Bluetooth speakers, where it can self-interrupt
SPEAK_BETWEEN_TOOLS=true      # speak a turn's text as it arrives, ahead of each tool call;
                              # false holds all of it until after the last tool call

# Ceiling on one brain turn, tool calls included — a bound on a stalled provider,
# not a latency budget. Healthy turns run 5-20s.
BRAIN_TIMEOUT_S=90
# How long a server's question (MCP elicitation) stays open before it is cancelled.
CHOICE_TIMEOUT_S=300

# Memory — keep the conversation across restarts. Also in the UI.
ENABLE_MEMORY=true
FAST_BODY_MEMORY_RESUME_H=6   # resume the last conversation if it is this recent (hours); 0 never resumes
FAST_BODY_MEMORY_DIR=         # blank = ~/.fast-body (conversations, skills, cards)
FAST_BODY_MEMORY_GREETING=true  # on a resumed run, say a line about where you left off
FAST_BODY_CONTEXT_BUDGET=60000  # tokens replayed to the brain before it is compacted; 0 = fast-agent's own threshold

# How much speech to buffer before the robot starts talking. The reply streams
# in, so too small a lead-in drains the player mid-word. Raise it if speech
# stutters; lower it to start talking sooner.
TTS_LEAD_IN_S=0.6
TTS_WARMUP=true               # one short synthesis at startup, so the first reply isn't slow

# Logging. Note this makes the websocket layer log a line per audio frame, which
# floods the robot's journal — leave it off unless you are reading those lines.
FAST_BODY_DEBUG=false

# Speech gating. The transcribe models answer non-speech audio with invented text,
# often in another language, so keep noise from reaching it at all.
VAD_AGGRESSIVENESS=3          # 0 lax … 3 strict; the mic sits next to fans
STT_MIN_SPEECH_MS=400         # voiced audio needed before transcribing
STT_MIN_RMS=0.012             # level needed; steady noise can pass the VAD quietly
STT_LANGUAGE=en               # blank lets the model guess, and on noise it guesses wildly

# Realtime backend (VOICE_BACKEND=realtime). The server endpoints the speech, so
# the three gates above don't apply — these replace them.
REALTIME_STT_MODEL=gpt-transcribe       # gpt-live-transcribe rejects turn detection, so not this one
REALTIME_NOISE_REDUCTION=far_field      # near_field for a headset; filters ahead of the VAD
REALTIME_VAD_THRESHOLD=0.5    # 0.0 lax … 1.0 strict; raise it if the room triggers turns
REALTIME_PREFIX_PADDING_MS=300  # audio kept from before speech was detected
REALTIME_SILENCE_MS=750       # silence that ends a turn
